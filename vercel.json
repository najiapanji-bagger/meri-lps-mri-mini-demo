{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/minidemo", "destination": "/index.html" },
    { "source": "/minidemo/", "destination": "/index.html" },
    { "source": "/minidemo/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/minidemo/meri.svg", "destination": "/meri.svg" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/minidemo/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
